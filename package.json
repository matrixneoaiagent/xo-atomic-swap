  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matrixneoaiagent/xo-atomic-swap"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "xo",
    "template",
    "covenant",
    "cashscript",
    "htlc",
    "atomic-swap",
    "bchblaze"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "invitations": "tsx scripts/make-invitations.ts",
    "faucet": "tsx scripts/faucet.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
